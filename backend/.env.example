# Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=ResearchMind AI
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production-min-32-chars

# Database (SQLite used by default for development)
DATABASE_URL=sqlite+aiosqlite:///./research_mind.db

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# OpenAI (Optional - for enhanced QA)
OPENAI_API_KEY=your-openai-api-key-here
# Set to "openai" to use OpenAI, "local" to use local models only
LLM_PROVIDER=local

# Hugging Face (Optional - for model downloads)
HUGGINGFACE_TOKEN=your-hf-token-here

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Model Settings
SUMMARIZATION_MODEL=facebook/bart-large-cnn
EMBEDDING_MODEL=all-MiniLM-L6-v2
NER_MODEL=en_core_web_sm

# Vector DB
VECTOR_DB_TYPE=faiss
CHROMA_PERSIST_DIR=./chroma_db
FAISS_INDEX_DIR=./faiss_indexes

# Processing
MAX_CHUNK_SIZE=512
CHUNK_OVERLAP=50
